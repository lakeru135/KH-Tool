<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The process Task Scheduler starts for a scheduled batch run.

    It exists because the thing it replaces did not survive contact with a second PC. Until 1.3.4
    the task ran `wscript.exe //B //NoLogo run_<id>.vbs` — a generated VBScript that set the job
    environment variables, started Revit, and waited. On a machine where Windows Script Host is
    disabled by policy (or VBScript, a Feature-on-Demand since Windows 11 24H2, has been removed),
    wscript exits 1 without running a line of the script: Revit never starts, nothing is logged,
    and Task Scheduler reports a bare 0x1. That is a machine-policy difference, so it reproduces on
    one PC and not another, which is the worst shape a failure can have.

    net48 rather than net8 deliberately. This is the one component that must run BEFORE Revit does,
    so it cannot assume anything Revit brings with it: .NET Framework 4.8 is present on every
    supported Windows 10/11 machine, while .NET 8 arrives with Revit 2025+. A net8 launcher would
    have swapped a scripting-host dependency for a runtime dependency and kept the same class of
    bug.

    WinExe, not Exe: a console window would flash on every scheduled run, which is the reason the
    cmd.exe launcher (XML-v2) was abandoned in the first place. Diagnostics go to the log file.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KhBatchLauncher</RootNamespace>
    <AssemblyName>KhBatchLauncher</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <!-- No satellite/deps clutter: this ships next to the add-in DLL, not into its own folder. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The environment-variable names are the contract between this process and the add-in that
         reads them inside Revit. Linked, never restated, so the two can never drift apart. -->
    <Compile Include="..\KhBatchRunner\Schedule\ScheduleEnvironment.cs"
             Link="Shared\Schedule\ScheduleEnvironment.cs" />

    <!-- Same reasoning for the toast ledger: the add-in decides retention (RunNotification.ExpiryFor)
         and this process records and enforces it, so the record's FORMAT is a contract between them
         too. Plain file I/O with no Revit types, which is why it can be compiled into a net48
         WinExe at all.

         LogFileLock comes with it because the sweep is a read-modify-write, and a parallel run has
         several Revit instances raising toasts at once — the exact concurrent-append problem that
         class was written for, and already proven against the tracking CSVs. -->
    <Compile Include="..\KhBatchRunner\Schedule\ToastLedger.cs"
             Link="Shared\Schedule\ToastLedger.cs" />
    <Compile Include="..\KhBatchRunner\Logging\LogFileLock.cs"
             Link="Shared\Logging\LogFileLock.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the notify mode (NotifyHost.cs / NotifyCard.cs): the notification window, its custom
         painting, and the message loop that makes it clickable. net48 needs these named explicitly;
         UseWindowsForms is .NET Core 3.0+ only. All three assemblies are part of the .NET Framework
         already on the machine, so this adds nothing to what ships beside the add-in. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
