<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The standalone controller: a normal Windows program that drives the KH Batch tooling with
    Revit demoted to a background worker. It references NO Revit assembly — everything here must
    build and run with Revit absent (it only needs Revit *installed* at runtime to broker a token
    or to execute a batch).

    WinExe, so double-clicking the app shows only the app. It was Exe while the console WAS the
    interface — the probe output is what made an invisible broker debuggable — but a shipped desktop
    program that opens a black window alongside its own looks broken.

    The console flows (probe, run, render) are NOT lost: Program.Main attaches to the parent
    console when there is one, and allocates its own when there is not, so running it from a
    terminal still prints. See AttachConsoleForCliRun there.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF is here for System.Windows.Automation only (AddInSecurityDialogHandler), which is
         how the controller answers Revit's unsigned-add-in prompt from outside the Revit process. -->
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KhBatchController</RootNamespace>
    <AssemblyName>KhBatchController</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <!-- Taskbar / Explorer / Alt-Tab icon: the Kanghun logo, generated from the add-in's own
         Resources\KanghunPureLogo.png at 16-256px so Windows never has to smear one large bitmap. -->
    <ApplicationIcon>KhBatchController.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Revit-free add-in source is LINKED, not copied and not moved: the shipping add-in keeps
    compiling these same files unchanged, and the controller proves the split works before anyone
    pays for extracting a real Core assembly. Only files with no `Autodesk.Revit` reference
    anywhere (including aliased usings) can be listed here.
  -->
  <ItemGroup>
    <Compile Include="..\KhBatchRunner\Auth\ITokenProvider.cs" Link="Shared\Auth\ITokenProvider.cs" />
    <!-- SessionTokenProvider reaches SSONET purely by reflection, so it compiles here even though
         it can only ever succeed inside Revit. Linked because it is PresetResolver's default;
         the controller always passes BrokerTokenProvider explicitly instead. -->
    <Compile Include="..\KhBatchRunner\Auth\SessionTokenProvider.cs" Link="Shared\Auth\SessionTokenProvider.cs" />

    <!-- Forma REST stack: Data Management + Model Derivative clients, their models and reports.
         Entirely Revit-free already — it authenticates with a bearer token, not a Revit session. -->
    <Compile Include="..\KhBatchRunner\Forma\**\*.cs" Link="Shared\Forma\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Model sets (presets) and their store: the controller reads the very same
         %AppData%\KhBatchRunner\Presets files the add-in writes. -->
    <Compile Include="..\KhBatchRunner\Presets\**\*.cs" Link="Shared\Presets\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- CSV logging + report writers, shared so a controller-driven run produces byte-identical
         logs to an add-in-driven one. -->
    <Compile Include="..\KhBatchRunner\Logging\**\*.cs" Link="Shared\Logging\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Reporting minus MatrixUtil.cs, which is the one file here that touches the Revit API. -->
    <Compile Include="..\KhBatchRunner\Reporting\**\*.cs" Exclude="..\KhBatchRunner\Reporting\MatrixUtil.cs" Link="Shared\Reporting\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- RunEndMatrix merges a supervised run's Batch Interop reports with it. It reads AIT only by
         reflection, on a ReportRun it is handed, so it has no Revit or AIT reference to compile. -->
    <Compile Include="..\KhBatchRunner\Interop\InteropExcelReport.cs" Link="Shared\Interop\InteropExcelReport.cs" />

    <!-- Batch: the job INPUTS (input sets, completion/sync options, folder scans) travel with a job
         and are pure data. Excluded are the six files that actually drive Revit documents — the
         engine, its drivers, the document cursor they share, and the dialog suppressor — which is
         the real add-in/controller line. -->
    <Compile Include="..\KhBatchRunner\Batch\**\*.cs" Link="Shared\Batch\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\KhBatchRunner\Batch\ActiveModelRunner.cs;..\KhBatchRunner\Batch\BatchEngine.cs;..\KhBatchRunner\Batch\BatchIdlingDriver.cs;..\KhBatchRunner\Batch\DialogSuppressor.cs;..\KhBatchRunner\Batch\LeftOpenDocsActivator.cs;..\KhBatchRunner\Batch\ModelDocumentCursor.cs;..\KhBatchRunner\Batch\WorksetContentsProbe.cs" />

    <!-- RunTrace is the shared launch/stage trail both processes append to; SelfTest is Revit-only. -->
    <Compile Include="..\KhBatchRunner\Diagnostics\RunTrace.cs" Link="Shared\Diagnostics\RunTrace.cs" />
    <!-- Dialog open-time instrumentation used by the shared windows; writes to RunTrace only. -->
    <Compile Include="..\KhBatchRunner\Diagnostics\OpenTimer.cs" Link="Shared\Diagnostics\OpenTimer.cs" />

    <!-- Job model + stores + the launch/supervise machinery: files and processes, which is precisely
         the part the controller should own. Three are excluded — ScheduledRunner (drives BatchEngine
         inside Revit), InteractiveSplit (a ribbon command's confirm-and-launch step, in Revit
         TaskDialogs and Results), and RelinkSplitGuard (plain data, but over RelinkTarget, which
         lives with the Revit-only relink action). -->
    <Compile Include="..\KhBatchRunner\Schedule\**\*.cs" Exclude="..\KhBatchRunner\Schedule\ScheduledRunner.cs;..\KhBatchRunner\Schedule\InteractiveSplit.cs;..\KhBatchRunner\Schedule\RelinkSplitGuard.cs" Link="Shared\Schedule\%(RecursiveDir)%(Filename)%(Extension)" />

    <Compile Include="..\KhBatchRunner\Settings\UserSettings.cs" Link="Shared\Settings\UserSettings.cs" />

    <!--
      The add-in dialogs the controller hosts, listed EXPLICITLY rather than globbed.
      The dividing line is not "does the file mention Revit" but "does this window need the action
      registry or a live document": Batch Run, the Schedule editors and the interop windows all
      construct concrete Revit actions (ActionRegistry, CutModelAction, …) to populate themselves,
      so they cannot cross without decoupling the registry — a real piece of work, deliberately not
      done for the demo. What is here is everything that only needs REST + stored config.
    -->
    <Compile Include="..\KhBatchRunner\UI\Theme.cs" Link="Shared\UI\Theme.cs" />
    <!-- Required because RunSupervisor (linked above) opens it for every interactive split run.
         Revit-free by design — it reads the tracking CSV and checks process ids, nothing else. -->
    <Compile Include="..\KhBatchRunner\UI\RunWatchWindow.cs" Link="Shared\UI\RunWatchWindow.cs" />
    <!-- The retained Notification Center toast RunWatchWindow raises. No Revit dependency. -->
    <Compile Include="..\KhBatchRunner\UI\RunNotification.cs" Link="Shared\UI\RunNotification.cs" />
    <Compile Include="..\KhBatchRunner\UI\Icons.cs" Link="Shared\UI\Icons.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormLayout.cs" Link="Shared\UI\FormLayout.cs" />
    <Compile Include="..\KhBatchRunner\UI\CheckListBehavior.cs" Link="Shared\UI\CheckListBehavior.cs" />
    <!-- The Forma model list both pickers share: columns for Revit year and model type, and the
         greying that stops an unrunnable model being chosen. -->
    <Compile Include="..\KhBatchRunner\UI\ModelCheckGrid.cs" Link="Shared\UI\ModelCheckGrid.cs" />
    <Compile Include="..\KhBatchRunner\UI\ScheduleDisplay.cs" Link="Shared\UI\ScheduleDisplay.cs" />
    <!-- The "N sets · N models -> N instances" line under the model-set lists. Pure arithmetic over
         saved presets; no Revit, and deliberately no Forma call (see its remarks). -->
    <Compile Include="..\KhBatchRunner\UI\SelectionSummary.cs" Link="Shared\UI\SelectionSummary.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaExtractReport.cs" Link="Shared\UI\FormaExtractReport.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaTreeController.cs" Link="Shared\UI\FormaTreeController.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaPickerWindow.cs" Link="Shared\UI\FormaPickerWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaFolderPickerWindow.cs" Link="Shared\UI\FormaFolderPickerWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaBrowserWindow.cs" Link="Shared\UI\FormaBrowserWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\FormaExtractWindow.cs" Link="Shared\UI\FormaExtractWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\DataExtractWindow.cs" Link="Shared\UI\DataExtractWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\CheckSheetPublishWindow.cs" Link="Shared\UI\CheckSheetPublishWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\EditScriptSetWindow.cs" Link="Shared\UI\EditScriptSetWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\AboutWindow.cs" Link="Shared\UI\AboutWindow.cs" />
    <!-- The add-in's OWN Schedule Run dialog, not a lookalike. Its only Revit ties were the action
         registry and one TaskDialog; both now go through UI\HostServices, which each host fills in. -->
    <Compile Include="..\KhBatchRunner\UI\HostServices.cs" Link="Shared\UI\HostServices.cs" />
    <Compile Include="..\KhBatchRunner\UI\TimeInput.cs" Link="Shared\UI\TimeInput.cs" />
    <Compile Include="..\KhBatchRunner\UI\ScheduleRunWindow.cs" Link="Shared\UI\ScheduleRunWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\StatusLine.cs" Link="Shared\UI\StatusLine.cs" />
    <Compile Include="..\KhBatchRunner\UI\DimmableCheckedListBox.cs" Link="Shared\UI\DimmableCheckedListBox.cs" />
    <Compile Include="..\KhBatchRunner\UI\LauncherRunner.cs" Link="Shared\UI\LauncherRunner.cs" />
    <Compile Include="..\KhBatchRunner\UI\MessageDetailsWindow.cs" Link="Shared\UI\MessageDetailsWindow.cs" />
    <Compile Include="..\KhBatchRunner\UI\ModelSetAccess.cs" Link="Shared\UI\ModelSetAccess.cs" />
    <Compile Include="..\KhBatchRunner\UI\SetDuplication.cs" Link="Shared\UI\SetDuplication.cs" />
    <Compile Include="..\KhBatchRunner\Settings\SettingsPaths.cs" Link="Shared\Settings\SettingsPaths.cs" />
    <Compile Include="..\KhBatchRunner\Actions\LinkWorksetNaming.cs" Link="Shared\Actions\LinkWorksetNaming.cs" />
    <Compile Include="..\KhBatchRunner\Actions\SyntheticActionPostures.cs" Link="Shared\Actions\SyntheticActionPostures.cs" />
    <Compile Include="..\KhBatchRunner\UI\Schedule\*.cs" Link="Shared\UI\Schedule\%(Filename)%(Extension)" />
    <Compile Include="..\KhBatchRunner\Actions\ActionNames.cs" Link="Shared\Actions\ActionNames.cs" />
    <Compile Include="..\KhBatchRunner\Settings\LegacyNames.cs" Link="Shared\Settings\LegacyNames.cs" />
    <Compile Include="..\KhBatchRunner\UI\ActionResultsWindow.cs" Link="Shared\UI\ActionResultsWindow.cs" />

    <!-- ActionCategory and WorksetPosture only; the rest of Actions\ is Revit-typed by nature.
         WorksetPosture is a bare enum — its only Autodesk mentions are doc-comment cref targets,
         which cost a warning here, not an error. Linked because UI\HostServices.ActionInfo carries
         the posture so the schedule editor can warn about an ordering that opens every model twice;
         the controller reports it too, from whatever the brokering Revit's registry declares. -->
    <Compile Include="..\KhBatchRunner\Actions\ActionCategory.cs" Link="Shared\Actions\ActionCategory.cs" />
    <Compile Include="..\KhBatchRunner\Actions\WorksetPosture.cs" Link="Shared\Actions\WorksetPosture.cs" />

    <!-- Script sets are stored config the controller can edit; DynamoInvoker executes them in Revit. -->
    <Compile Include="..\KhBatchRunner\Scripts\ScriptSet.cs" Link="Shared\Scripts\ScriptSet.cs" />
    <Compile Include="..\KhBatchRunner\Scripts\ScriptSetStore.cs" Link="Shared\Scripts\ScriptSetStore.cs" />

    <Compile Include="..\KhBatchRunner\Product.cs" Link="Shared\Product.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same logo the add-in embeds, embedded here too. Icons.LoadLogo() resolves it from the
      EXECUTING assembly and matches on the file-name suffix, so the controller must carry its own
      copy — without this, Theme.Apply silently finds nothing and every window falls back to the
      default WinForms icon. LogicalName is pinned so the suffix match holds regardless of how
      MSBuild would otherwise name a resource linked from outside the project directory.
    -->
    <EmbeddedResource Include="..\KhBatchRunner\Resources\KanghunPureLogo.png"
                      LogicalName="KhBatchController.Resources.KanghunPureLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The linked sources use System.Text.Json; match the add-in's pinned version. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
